# Rubenchik Mirror - UxPlay startup options (one option per line, without the leading "-").
# Edit this file, then restart Rubenchik Mirror. Reference: uxplay -h

# Name shown in the iPhone's Screen Mirroring list, without "@hostname" suffix
n "Rubenchik Mirror"
nh

# Fullscreen (works with the Direct3D 11 video sink)
fs

# Direct3D 11 video sink (Alt+Enter toggles fullscreen)
vs d3d11videosink

# Request 1080p at 60 fps from the iPhone (it may choose a lower rate)
s 1920x1080@60
fps 60

# YouTube: tapping the AirPlay icon in the YouTube iOS app plays the video directly on this PC
# (the phone becomes a remote). Without this option only the audio is received.
hls

# Audio is on by default. Uncomment to pick a specific Windows audio sink:
# as wasapisink

# Uncomment for lowest latency (disables audio/video timestamp sync; best for games/UI, not movies):
# vsync no
