diff --git a/renderers/mpv_hls.h b/renderers/mpv_hls.h
new file mode 100644
index 0000000..425f71a
--- /dev/null
+++ b/renderers/mpv_hls.h
@@ -0,0 +1,395 @@
+/*
+ * Rubenchik Mirror: optional mpv backend for AirPlay HLS (YouTube) playback on Windows.
+ *
+ * GStreamer's playbin3/hlsdemux2 freezes after seeking on many Windows systems, so for HLS video we run
+ * mpv.exe (placed next to uxplay.exe) and control it over its JSON IPC named pipe.
+ * One mpv instance (one window) is kept alive between videos: a new video is loaded into the same window, and the
+ * window is closed a few seconds after playback has ended.
+ * Header-only, Windows-only; on other platforms every function reports "not available" and the
+ * GStreamer code path is used.
+ *
+ * License: GPL-3.0-or-later (same as UxPlay).
+ */
+#ifndef MPV_HLS_H
+#define MPV_HLS_H
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+
+#define MPV_IDLE_CLOSE_MS 5000
+
+static HANDLE mpv_proc = NULL;
+static HANDLE mpv_pipe = INVALID_HANDLE_VALUE;
+static HANDLE mpv_job = NULL;
+static HANDLE mpv_watcher = NULL;
+static CRITICAL_SECTION mpv_lock;
+static bool mpv_lock_init = false;
+static int mpv_req_id = 0;
+static DWORD mpv_idle_since = 0;   /* tick count when playback stopped; 0 = playing */
+
+static void mpv_hls_lock(void) {
+    if (!mpv_lock_init) {
+        InitializeCriticalSection(&mpv_lock);
+        mpv_lock_init = true;
+    }
+    EnterCriticalSection(&mpv_lock);
+}
+static void mpv_hls_unlock(void) { LeaveCriticalSection(&mpv_lock); }
+
+static bool mpv_hls_path(char *out, size_t len) {
+    char exe[MAX_PATH];
+    DWORD n = GetModuleFileNameA(NULL, exe, MAX_PATH);
+    if (n == 0 || n >= MAX_PATH) return false;
+    char *slash = strrchr(exe, '\\');
+    if (!slash) return false;
+    *(slash + 1) = '\0';
+    snprintf(out, len, "%smpv.exe", exe);
+    return GetFileAttributesA(out) != INVALID_FILE_ATTRIBUTES;
+}
+
+/* true if the mpv backend can be used (mpv.exe found next to uxplay.exe and not disabled by RUBENCHIK_NO_MPV) */
+static bool mpv_hls_available(void) {
+    char p[MAX_PATH + 16];
+    if (getenv("RUBENCHIK_NO_MPV")) return false;
+    return mpv_hls_path(p, sizeof(p));
+}
+
+static bool mpv_hls_alive(void) {
+    if (!mpv_proc) return false;
+    return WaitForSingleObject(mpv_proc, 0) == WAIT_TIMEOUT;
+}
+
+/* Close mpv completely (window included). Caller holds the lock. */
+static void mpv_hls_quit_locked(void) {
+    if (mpv_pipe != INVALID_HANDLE_VALUE) {
+        const char *q = "{\"command\":[\"quit\"]}\n";
+        DWORD w;
+        WriteFile(mpv_pipe, q, (DWORD) strlen(q), &w, NULL);
+        CloseHandle(mpv_pipe);
+        mpv_pipe = INVALID_HANDLE_VALUE;
+    }
+    if (mpv_proc) {
+        if (WaitForSingleObject(mpv_proc, 800) == WAIT_TIMEOUT) {
+            TerminateProcess(mpv_proc, 0);
+        }
+        CloseHandle(mpv_proc);
+        mpv_proc = NULL;
+    }
+    mpv_idle_since = 0;
+}
+
+/* Send a JSON command line, wait (max 1.5 s) for the reply with our request_id; the reply text is copied to reply. */
+static bool mpv_hls_cmd(const char *json_command_array, char *reply, size_t reply_len) {
+    if (mpv_pipe == INVALID_HANDLE_VALUE) return false;
+    static char line[10240];
+    int id = ++mpv_req_id;
+    int n = snprintf(line, sizeof(line), "{\"command\":%s,\"request_id\":%d}\n", json_command_array, id);
+    DWORD w;
+    if (!WriteFile(mpv_pipe, line, (DWORD) n, &w, NULL)) return false;
+    static char buf[65536];
+    size_t have = 0;
+    char key[32];
+    snprintf(key, sizeof(key), "\"request_id\":%d", id);
+    DWORD start = GetTickCount();
+    while (GetTickCount() - start < 1500) {
+        DWORD avail = 0;
+        if (!PeekNamedPipe(mpv_pipe, NULL, 0, NULL, &avail, NULL)) return false;
+        if (avail == 0) { Sleep(2); continue; }
+        DWORD r = 0;
+        if (have + 1 >= sizeof(buf)) have = 0;
+        if (!ReadFile(mpv_pipe, buf + have, (DWORD) (sizeof(buf) - 1 - have), &r, NULL) || r == 0) return false;
+        have += r;
+        buf[have] = '\0';
+        char *ls = buf;
+        char *nl;
+        while ((nl = strchr(ls, '\n'))) {
+            *nl = '\0';
+            if (strstr(ls, key)) {
+                if (reply) { strncpy(reply, ls, reply_len - 1); reply[reply_len - 1] = '\0'; }
+                return true;
+            }
+            ls = nl + 1;
+        }
+        have = strlen(ls);
+        memmove(buf, ls, have + 1);
+    }
+    return false;
+}
+
+static bool mpv_hls_get_number(const char *prop, double *value) {
+    char cmd[128], reply[512];
+    snprintf(cmd, sizeof(cmd), "[\"get_property\",\"%s\"]", prop);
+    if (!mpv_hls_cmd(cmd, reply, sizeof(reply))) return false;
+    if (!strstr(reply, "\"error\":\"success\"")) return false;
+    char *d = strstr(reply, "\"data\":");
+    if (!d) return false;
+    *value = strtod(d + 7, NULL);
+    return true;
+}
+
+static bool mpv_hls_get_bool(const char *prop, bool *value) {
+    char cmd[128], reply[512];
+    snprintf(cmd, sizeof(cmd), "[\"get_property\",\"%s\"]", prop);
+    if (!mpv_hls_cmd(cmd, reply, sizeof(reply))) return false;
+    if (!strstr(reply, "\"error\":\"success\"")) return false;
+    char *d = strstr(reply, "\"data\":");
+    if (!d) return false;
+    *value = (strncmp(d + 7, "true", 4) == 0);
+    return true;
+}
+
+/* background thread: close the (idle, black) mpv window a few seconds after playback ended */
+static DWORD WINAPI mpv_hls_watcher(LPVOID arg) {
+    (void) arg;
+    for (;;) {
+        Sleep(500);
+        mpv_hls_lock();
+        if (mpv_idle_since && (GetTickCount() - mpv_idle_since) > MPV_IDLE_CLOSE_MS) {
+            mpv_hls_quit_locked();
+        }
+        mpv_hls_unlock();
+    }
+    return 0;
+}
+
+/* Spawn mpv (idle, no file) and connect to its IPC pipe. Caller holds the lock. */
+static bool mpv_hls_spawn_locked(bool fullscreen, double volume, const char *title) {
+    char exe[MAX_PATH + 16];
+    if (!mpv_hls_path(exe, sizeof(exe))) return false;
+    char pipe_name[128];
+    snprintf(pipe_name, sizeof(pipe_name), "\\\\.\\pipe\\rubenchik-mirror-mpv-%lu", (unsigned long) GetCurrentProcessId());
+    char logopt[600] = "";
+    if (getenv("RUBENCHIK_MPV_LOG")) {
+        snprintf(logopt, sizeof(logopt), "--log-file=\"%s\" --msg-level=all=v ", getenv("RUBENCHIK_MPV_LOG"));
+    }
+    /* fonts for subtitles: use the fontconfig configuration shipped with the app (<app>\etc\fonts), if present */
+    {
+        char fc[MAX_PATH + 32];
+        snprintf(fc, sizeof(fc), "%s", exe);
+        char *sl = strrchr(fc, '\\');
+        if (sl) {
+            *sl = 0;                          /* now ...\bin */
+            sl = strrchr(fc, '\\');
+            if (sl) {
+                *sl = 0;                      /* now the app root */
+                strncat(fc, "\\etc\\fonts", sizeof(fc) - strlen(fc) - 1);
+                if (GetFileAttributesA(fc) != INVALID_FILE_ATTRIBUTES) {
+                    SetEnvironmentVariableA("FONTCONFIG_PATH", fc);
+                }
+            }
+        }
+    }
+    char cmdline[4096];
+    snprintf(cmdline, sizeof(cmdline),
+             "\"%s\" --no-config --idle=yes --force-window=yes --title=\"%s\" --input-ipc-server=%s --keep-open=no "
+             "--osc=no --no-terminal --ytdl=no --hwdec=auto-safe --cache=yes --demuxer-lavf-analyzeduration=2 %s--volume=%d %s",
+             exe, title ? title : "Rubenchik Mirror", pipe_name, logopt,
+             (int) (volume * 100.0 > 100.0 ? 100 : volume * 100.0), fullscreen ? "--fs" : "");
+    STARTUPINFOA si;
+    PROCESS_INFORMATION pi;
+    memset(&si, 0, sizeof(si));
+    si.cb = sizeof(si);
+    memset(&pi, 0, sizeof(pi));
+    if (!CreateProcessA(NULL, cmdline, NULL, NULL, FALSE, CREATE_NO_WINDOW | CREATE_SUSPENDED, NULL, NULL, &si, &pi)) {
+        return false;
+    }
+    /* make mpv die together with uxplay */
+    if (!mpv_job) {
+        mpv_job = CreateJobObjectA(NULL, NULL);
+        if (mpv_job) {
+            JOBOBJECT_EXTENDED_LIMIT_INFORMATION info;
+            memset(&info, 0, sizeof(info));
+            info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+            SetInformationJobObject(mpv_job, JobObjectExtendedLimitInformation, &info, sizeof(info));
+        }
+    }
+    if (mpv_job) AssignProcessToJobObject(mpv_job, pi.hProcess);
+    ResumeThread(pi.hThread);
+    CloseHandle(pi.hThread);
+    mpv_proc = pi.hProcess;
+    DWORD t0 = GetTickCount();
+    while (GetTickCount() - t0 < 8000) {
+        mpv_pipe = CreateFileA(pipe_name, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL);
+        if (mpv_pipe != INVALID_HANDLE_VALUE) break;
+        if (!mpv_hls_alive()) break;
+        Sleep(50);
+    }
+    if (mpv_pipe == INVALID_HANDLE_VALUE) {
+        mpv_hls_quit_locked();
+        return false;
+    }
+    if (!mpv_watcher) {
+        mpv_watcher = CreateThread(NULL, 0, mpv_hls_watcher, NULL, 0, NULL);
+    }
+    return true;
+}
+
+/* JSON-escape a URL for embedding in a command */
+static void mpv_hls_json_escape(const char *in, char *out, size_t outlen) {
+    size_t j = 0;
+    for (size_t i = 0; in[i] && j + 3 < outlen; i++) {
+        if (in[i] == '"' || in[i] == '\\') out[j++] = '\\';
+        out[j++] = in[i];
+    }
+    out[j] = '\0';
+}
+
+/* Play url starting at start_pos seconds, in the existing mpv window if there is one. Returns false on failure. */
+static bool mpv_hls_start(const char *url, double start_pos, bool fullscreen, double volume, const char *title) {
+    mpv_hls_lock();
+    if (!(mpv_hls_alive() && mpv_pipe != INVALID_HANDLE_VALUE)) {
+        mpv_hls_quit_locked();
+        if (!mpv_hls_spawn_locked(fullscreen, volume, title)) {
+            mpv_hls_unlock();
+            return false;
+        }
+    }
+    static char esc[4096];
+    static char cmd[5000];
+    mpv_hls_json_escape(url, esc, sizeof(esc));
+    snprintf(cmd, sizeof(cmd), "[\"loadfile\",\"%s\",\"replace\",-1,{\"start\":\"%.3f\",\"pause\":\"no\"}]", esc, start_pos > 0 ? start_pos : 0.0);
+    char reply[512];
+    bool ok = mpv_hls_cmd(cmd, reply, sizeof(reply)) && strstr(reply, "\"error\":\"success\"");
+    if (ok) {
+        mpv_idle_since = 0;
+        mpv_hls_cmd("[\"set_property\",\"speed\",1.0]", NULL, 0);
+    }
+    mpv_hls_unlock();
+    return ok;
+}
+
+/* Stop playback. The window stays for a few seconds (in case another video follows) and is then closed. */
+static void mpv_hls_stop(void) {
+    mpv_hls_lock();
+    if (mpv_hls_alive() && mpv_pipe != INVALID_HANDLE_VALUE) {
+        mpv_hls_cmd("[\"stop\"]", NULL, 0);
+        if (!mpv_idle_since) mpv_idle_since = GetTickCount() | 1;
+    }
+    mpv_hls_unlock();
+}
+
+static void mpv_hls_set_pause(bool pause) {
+    mpv_hls_lock();
+    mpv_hls_cmd(pause ? "[\"set_property\",\"pause\",true]" : "[\"set_property\",\"pause\",false]", NULL, 0);
+    mpv_hls_unlock();
+}
+
+static void mpv_hls_seek(double position) {
+    char cmd[128];
+    snprintf(cmd, sizeof(cmd), "[\"seek\",%.3f,\"absolute\"]", position);
+    mpv_hls_lock();
+    mpv_hls_cmd(cmd, NULL, 0);
+    mpv_hls_unlock();
+}
+
+static void mpv_hls_set_speed(double speed) {
+    char cmd[128];
+    snprintf(cmd, sizeof(cmd), "[\"set_property\",\"speed\",%.3f]", speed);
+    mpv_hls_lock();
+    mpv_hls_cmd(cmd, NULL, 0);
+    mpv_hls_unlock();
+}
+
+/* find the id of the first track of the given type ("audio" or "sub") whose language starts with the first two letters of
+   lang (any track if lang is empty); returns -1 if none. json is mpv's reply to get_property track-list. */
+static int mpv_hls_find_track(const char *json, const char *type, const char *lang) {
+    char want_type[32];
+    snprintf(want_type, sizeof(want_type), "\"type\":\"%s\"", type);
+    const char *p = json;
+    while ((p = strstr(p, "{\"id\":")) != NULL) {
+        const char *next = strstr(p + 6, "{\"id\":");
+        size_t len = next ? (size_t) (next - p) : strlen(p);
+        char obj[2048];
+        if (len >= sizeof(obj)) len = sizeof(obj) - 1;
+        memcpy(obj, p, len);
+        obj[len] = '\0';
+        if (strstr(obj, want_type)) {
+            bool ok = true;
+            if (lang && lang[0] && strcmp(lang, "und")) {
+                char key[16];
+                const char *l = strstr(obj, "\"lang\":\"");
+                snprintf(key, sizeof(key), "%.2s", lang);
+                ok = l && !_strnicmp(l + 8, key, 2);
+            }
+            if (ok) return atoi(p + 6);
+        }
+        p += 6;
+    }
+    return -1;
+}
+
+static void mpv_hls_select_media(int sub_on, const char *sub_lang, const char *audio_lang) {
+    static char reply[65536];
+    mpv_hls_lock();
+    if (mpv_hls_cmd("[\"get_property\",\"track-list\"]", reply, sizeof(reply))) {
+        char cmd[96];
+        if (audio_lang && audio_lang[0] && strcmp(audio_lang, "und")) {
+            int id = mpv_hls_find_track(reply, "audio", audio_lang);
+            if (id > 0) {
+                snprintf(cmd, sizeof(cmd), "[\"set_property\",\"aid\",%d]", id);
+                mpv_hls_cmd(cmd, NULL, 0);
+            }
+        }
+        if (sub_on) {
+            int id = mpv_hls_find_track(reply, "sub", sub_lang);
+            if (id < 0) id = mpv_hls_find_track(reply, "sub", NULL);
+            if (id > 0) {
+                snprintf(cmd, sizeof(cmd), "[\"set_property\",\"sid\",%d]", id);
+                mpv_hls_cmd(cmd, NULL, 0);
+                mpv_hls_cmd("[\"set_property\",\"sub-visibility\",true]", NULL, 0);
+            }
+        } else {
+            mpv_hls_cmd("[\"set_property\",\"sid\",\"no\"]", NULL, 0);
+        }
+    }
+    mpv_hls_unlock();
+}
+
+static void mpv_hls_set_volume(double volume_0_to_1) {
+    char cmd[128];
+    snprintf(cmd, sizeof(cmd), "[\"set_property\",\"volume\",%.1f]", volume_0_to_1 * 100.0);
+    mpv_hls_lock();
+    mpv_hls_cmd(cmd, NULL, 0);
+    mpv_hls_unlock();
+}
+
+/* Returns false once the video has finished (mpv idle) or mpv has exited (window closed). */
+static bool mpv_hls_info(double *duration, double *position, bool *paused, bool *buffering) {
+    mpv_hls_lock();
+    bool alive = mpv_hls_alive() && mpv_pipe != INVALID_HANDLE_VALUE;
+    if (alive) {
+        bool idle = false;
+        if (mpv_hls_get_bool("idle-active", &idle) && idle) {
+            alive = false;
+        } else {
+            double d = 0, p = -1;
+            bool b = false, pz = false;
+            if (mpv_hls_get_number("duration", &d)) *duration = d;
+            if (mpv_hls_get_number("time-pos", &p)) *position = p;
+            if (mpv_hls_get_bool("pause", &pz)) *paused = pz;
+            if (mpv_hls_get_bool("paused-for-cache", &b)) *buffering = b;
+        }
+    }
+    mpv_hls_unlock();
+    return alive;
+}
+
+#else  /* not Windows: backend unavailable */
+
+static bool mpv_hls_available(void) { return false; }
+static bool mpv_hls_start(const char *url, double start_pos, bool fullscreen, double volume, const char *title) { (void) url; (void) start_pos; (void) fullscreen; (void) volume; (void) title; return false; }
+static void mpv_hls_stop(void) {}
+static void mpv_hls_set_pause(bool pause) { (void) pause; }
+static void mpv_hls_seek(double position) { (void) position; }
+static void mpv_hls_set_volume(double v) { (void) v; }
+static void mpv_hls_set_speed(double s) { (void) s; }
+static void mpv_hls_select_media(int a, const char *b, const char *c) { (void) a; (void) b; (void) c; }
+static bool mpv_hls_info(double *duration, double *position, bool *paused, bool *buffering) { (void) duration; (void) position; (void) paused; (void) buffering; return false; }
+
+#endif
+#endif /* MPV_HLS_H */
