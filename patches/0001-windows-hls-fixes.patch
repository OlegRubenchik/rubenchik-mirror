diff --git a/renderers/mpv_hls.h b/renderers/mpv_hls.h
new file mode 100644
index 0000000..2f08e6d
--- /dev/null
+++ b/renderers/mpv_hls.h
@@ -0,0 +1,414 @@
+/*
+ * Rubenchik Mirror: optional mpv backend for AirPlay HLS (YouTube) playback on Windows.
+ *
+ * GStreamer's playbin3/hlsdemux2 freezes after seeking on many Windows systems, so for HLS video we run
+ * mpv.exe (placed next to uxplay.exe) and control it over its JSON IPC named pipe.
+ * One mpv instance (one window) is kept alive between videos: a new video is loaded into the same window, and the
+ * window is closed a few seconds after playback has ended.
+ * Header-only, Windows-only; on other platforms every function reports "not available" and the
+ * GStreamer code path is used.
+ *
+ * License: GPL-3.0-or-later (same as UxPlay).
+ */
+#ifndef MPV_HLS_H
+#define MPV_HLS_H
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+
+#define MPV_IDLE_CLOSE_MS 5000
+
+static HANDLE mpv_proc = NULL;
+static HANDLE mpv_pipe = INVALID_HANDLE_VALUE;
+static HANDLE mpv_job = NULL;
+static HANDLE mpv_watcher = NULL;
+static CRITICAL_SECTION mpv_lock;
+static bool mpv_lock_init = false;
+static int mpv_req_id = 0;
+static DWORD mpv_idle_since = 0;   /* tick count when playback stopped; 0 = playing */
+static uintptr_t mpv_wid = 0;      /* host window to embed mpv into (0: mpv opens its own window) */
+static DWORD mpv_load_tick = 0;    /* when the last loadfile command was sent */
+static bool mpv_seen_file = false; /* mpv has started working on the file (is no longer idle) since loadfile */
+
+static void mpv_hls_set_wid(uintptr_t wid) { mpv_wid = wid; }
+
+static void mpv_hls_lock(void) {
+    if (!mpv_lock_init) {
+        InitializeCriticalSection(&mpv_lock);
+        mpv_lock_init = true;
+    }
+    EnterCriticalSection(&mpv_lock);
+}
+static void mpv_hls_unlock(void) { LeaveCriticalSection(&mpv_lock); }
+
+static bool mpv_hls_path(char *out, size_t len) {
+    char exe[MAX_PATH];
+    DWORD n = GetModuleFileNameA(NULL, exe, MAX_PATH);
+    if (n == 0 || n >= MAX_PATH) return false;
+    char *slash = strrchr(exe, '\\');
+    if (!slash) return false;
+    *(slash + 1) = '\0';
+    snprintf(out, len, "%smpv.exe", exe);
+    return GetFileAttributesA(out) != INVALID_FILE_ATTRIBUTES;
+}
+
+/* true if the mpv backend can be used (mpv.exe found next to uxplay.exe and not disabled by RUBENCHIK_NO_MPV) */
+static bool mpv_hls_available(void) {
+    char p[MAX_PATH + 16];
+    if (getenv("RUBENCHIK_NO_MPV")) return false;
+    return mpv_hls_path(p, sizeof(p));
+}
+
+static bool mpv_hls_alive(void) {
+    if (!mpv_proc) return false;
+    return WaitForSingleObject(mpv_proc, 0) == WAIT_TIMEOUT;
+}
+
+/* Close mpv completely (window included). Caller holds the lock. */
+static void mpv_hls_quit_locked(void) {
+    if (mpv_pipe != INVALID_HANDLE_VALUE) {
+        const char *q = "{\"command\":[\"quit\"]}\n";
+        DWORD w;
+        WriteFile(mpv_pipe, q, (DWORD) strlen(q), &w, NULL);
+        CloseHandle(mpv_pipe);
+        mpv_pipe = INVALID_HANDLE_VALUE;
+    }
+    if (mpv_proc) {
+        if (WaitForSingleObject(mpv_proc, 800) == WAIT_TIMEOUT) {
+            TerminateProcess(mpv_proc, 0);
+        }
+        CloseHandle(mpv_proc);
+        mpv_proc = NULL;
+    }
+    mpv_idle_since = 0;
+}
+
+/* Send a JSON command line, wait (max 1.5 s) for the reply with our request_id; the reply text is copied to reply. */
+static bool mpv_hls_cmd(const char *json_command_array, char *reply, size_t reply_len) {
+    if (mpv_pipe == INVALID_HANDLE_VALUE) return false;
+    static char line[10240];
+    int id = ++mpv_req_id;
+    int n = snprintf(line, sizeof(line), "{\"command\":%s,\"request_id\":%d}\n", json_command_array, id);
+    DWORD w;
+    if (!WriteFile(mpv_pipe, line, (DWORD) n, &w, NULL)) return false;
+    static char buf[65536];
+    size_t have = 0;
+    char key[32];
+    snprintf(key, sizeof(key), "\"request_id\":%d", id);
+    DWORD start = GetTickCount();
+    while (GetTickCount() - start < 1500) {
+        DWORD avail = 0;
+        if (!PeekNamedPipe(mpv_pipe, NULL, 0, NULL, &avail, NULL)) return false;
+        if (avail == 0) { Sleep(2); continue; }
+        DWORD r = 0;
+        if (have + 1 >= sizeof(buf)) have = 0;
+        if (!ReadFile(mpv_pipe, buf + have, (DWORD) (sizeof(buf) - 1 - have), &r, NULL) || r == 0) return false;
+        have += r;
+        buf[have] = '\0';
+        char *ls = buf;
+        char *nl;
+        while ((nl = strchr(ls, '\n'))) {
+            *nl = '\0';
+            if (strstr(ls, key)) {
+                if (reply) { strncpy(reply, ls, reply_len - 1); reply[reply_len - 1] = '\0'; }
+                return true;
+            }
+            ls = nl + 1;
+        }
+        have = strlen(ls);
+        memmove(buf, ls, have + 1);
+    }
+    return false;
+}
+
+static bool mpv_hls_get_number(const char *prop, double *value) {
+    char cmd[128], reply[512];
+    snprintf(cmd, sizeof(cmd), "[\"get_property\",\"%s\"]", prop);
+    if (!mpv_hls_cmd(cmd, reply, sizeof(reply))) return false;
+    if (!strstr(reply, "\"error\":\"success\"")) return false;
+    char *d = strstr(reply, "\"data\":");
+    if (!d) return false;
+    *value = strtod(d + 7, NULL);
+    return true;
+}
+
+static bool mpv_hls_get_bool(const char *prop, bool *value) {
+    char cmd[128], reply[512];
+    snprintf(cmd, sizeof(cmd), "[\"get_property\",\"%s\"]", prop);
+    if (!mpv_hls_cmd(cmd, reply, sizeof(reply))) return false;
+    if (!strstr(reply, "\"error\":\"success\"")) return false;
+    char *d = strstr(reply, "\"data\":");
+    if (!d) return false;
+    *value = (strncmp(d + 7, "true", 4) == 0);
+    return true;
+}
+
+/* background thread: close the (idle, black) mpv window a few seconds after playback ended */
+static DWORD WINAPI mpv_hls_watcher(LPVOID arg) {
+    (void) arg;
+    for (;;) {
+        Sleep(500);
+        mpv_hls_lock();
+        if (mpv_idle_since && (GetTickCount() - mpv_idle_since) > MPV_IDLE_CLOSE_MS) {
+            mpv_hls_quit_locked();
+        }
+        mpv_hls_unlock();
+    }
+    return 0;
+}
+
+/* Spawn mpv (idle, no file) and connect to its IPC pipe. Caller holds the lock. */
+static bool mpv_hls_spawn_locked(bool fullscreen, double volume, const char *title) {
+    char exe[MAX_PATH + 16];
+    if (!mpv_hls_path(exe, sizeof(exe))) return false;
+    char pipe_name[128];
+    snprintf(pipe_name, sizeof(pipe_name), "\\\\.\\pipe\\rubenchik-mirror-mpv-%lu", (unsigned long) GetCurrentProcessId());
+    char logopt[600] = "";
+    if (getenv("RUBENCHIK_MPV_LOG")) {
+        snprintf(logopt, sizeof(logopt), "--log-file=\"%s\" --msg-level=all=v ", getenv("RUBENCHIK_MPV_LOG"));
+    }
+    /* fonts for subtitles: use the fontconfig configuration shipped with the app (<app>\etc\fonts), if present */
+    {
+        char fc[MAX_PATH + 32];
+        snprintf(fc, sizeof(fc), "%s", exe);
+        char *sl = strrchr(fc, '\\');
+        if (sl) {
+            *sl = 0;                          /* now ...\bin */
+            sl = strrchr(fc, '\\');
+            if (sl) {
+                *sl = 0;                      /* now the app root */
+                strncat(fc, "\\etc\\fonts", sizeof(fc) - strlen(fc) - 1);
+                if (GetFileAttributesA(fc) != INVALID_FILE_ATTRIBUTES) {
+                    SetEnvironmentVariableA("FONTCONFIG_PATH", fc);
+                }
+            }
+        }
+    }
+    char widopt[160] = "";
+    if (mpv_wid) {
+        snprintf(widopt, sizeof(widopt), "--wid=%llu --no-input-default-bindings --no-input-cursor --cursor-autohide=always ", (unsigned long long) mpv_wid);
+        fullscreen = false;   /* the host window handles fullscreen */
+    }
+    char cmdline[4096];
+    snprintf(cmdline, sizeof(cmdline),
+             "\"%s\" --no-config --idle=yes --force-window=yes --title=\"%s\" --input-ipc-server=%s --keep-open=no "
+             "--osc=no --no-terminal --ytdl=no --hwdec=auto-safe --cache=yes --demuxer-lavf-analyzeduration=2 "
+             "--user-agent=\"AppleCoreMedia/1.0.0.23G90 (iPhone; U; CPU OS 18_6 like Mac OS X; en_us)\" %s%s--volume=%d %s",
+             exe, title ? title : "Rubenchik Mirror", pipe_name, logopt, widopt,
+             (int) (volume * 100.0 > 100.0 ? 100 : volume * 100.0), fullscreen ? "--fs" : "");
+    STARTUPINFOA si;
+    PROCESS_INFORMATION pi;
+    memset(&si, 0, sizeof(si));
+    si.cb = sizeof(si);
+    memset(&pi, 0, sizeof(pi));
+    if (!CreateProcessA(NULL, cmdline, NULL, NULL, FALSE, CREATE_NO_WINDOW | CREATE_SUSPENDED, NULL, NULL, &si, &pi)) {
+        return false;
+    }
+    /* make mpv die together with uxplay */
+    if (!mpv_job) {
+        mpv_job = CreateJobObjectA(NULL, NULL);
+        if (mpv_job) {
+            JOBOBJECT_EXTENDED_LIMIT_INFORMATION info;
+            memset(&info, 0, sizeof(info));
+            info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+            SetInformationJobObject(mpv_job, JobObjectExtendedLimitInformation, &info, sizeof(info));
+        }
+    }
+    if (mpv_job) AssignProcessToJobObject(mpv_job, pi.hProcess);
+    ResumeThread(pi.hThread);
+    CloseHandle(pi.hThread);
+    mpv_proc = pi.hProcess;
+    DWORD t0 = GetTickCount();
+    while (GetTickCount() - t0 < 8000) {
+        mpv_pipe = CreateFileA(pipe_name, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL);
+        if (mpv_pipe != INVALID_HANDLE_VALUE) break;
+        if (!mpv_hls_alive()) break;
+        Sleep(50);
+    }
+    if (mpv_pipe == INVALID_HANDLE_VALUE) {
+        mpv_hls_quit_locked();
+        return false;
+    }
+    if (!mpv_watcher) {
+        mpv_watcher = CreateThread(NULL, 0, mpv_hls_watcher, NULL, 0, NULL);
+    }
+    return true;
+}
+
+/* JSON-escape a URL for embedding in a command */
+static void mpv_hls_json_escape(const char *in, char *out, size_t outlen) {
+    size_t j = 0;
+    for (size_t i = 0; in[i] && j + 3 < outlen; i++) {
+        if (in[i] == '"' || in[i] == '\\') out[j++] = '\\';
+        out[j++] = in[i];
+    }
+    out[j] = '\0';
+}
+
+/* Play url starting at start_pos seconds, in the existing mpv window if there is one. Returns false on failure. */
+static bool mpv_hls_start(const char *url, double start_pos, bool fullscreen, double volume, const char *title) {
+    mpv_hls_lock();
+    if (!(mpv_hls_alive() && mpv_pipe != INVALID_HANDLE_VALUE)) {
+        mpv_hls_quit_locked();
+        if (!mpv_hls_spawn_locked(fullscreen, volume, title)) {
+            mpv_hls_unlock();
+            return false;
+        }
+    }
+    static char esc[4096];
+    static char cmd[5000];
+    mpv_hls_json_escape(url, esc, sizeof(esc));
+    snprintf(cmd, sizeof(cmd), "[\"loadfile\",\"%s\",\"replace\",-1,{\"start\":\"%.3f\",\"pause\":\"no\"}]", esc, start_pos > 0 ? start_pos : 0.0);
+    char reply[512];
+    bool ok = mpv_hls_cmd(cmd, reply, sizeof(reply)) && strstr(reply, "\"error\":\"success\"");
+    if (ok) {
+        mpv_idle_since = 0;
+        mpv_load_tick = GetTickCount();
+        mpv_seen_file = false;
+        mpv_hls_cmd("[\"set_property\",\"speed\",1.0]", NULL, 0);
+    }
+    mpv_hls_unlock();
+    return ok;
+}
+
+/* Stop playback. The window stays for a few seconds (in case another video follows) and is then closed. */
+static void mpv_hls_stop(void) {
+    mpv_hls_lock();
+    if (mpv_hls_alive() && mpv_pipe != INVALID_HANDLE_VALUE) {
+        mpv_hls_cmd("[\"stop\"]", NULL, 0);
+        if (!mpv_idle_since) mpv_idle_since = GetTickCount() | 1;
+    }
+    mpv_hls_unlock();
+}
+
+static void mpv_hls_set_pause(bool pause) {
+    mpv_hls_lock();
+    mpv_hls_cmd(pause ? "[\"set_property\",\"pause\",true]" : "[\"set_property\",\"pause\",false]", NULL, 0);
+    mpv_hls_unlock();
+}
+
+static void mpv_hls_seek(double position) {
+    char cmd[128];
+    snprintf(cmd, sizeof(cmd), "[\"seek\",%.3f,\"absolute\"]", position);
+    mpv_hls_lock();
+    mpv_hls_cmd(cmd, NULL, 0);
+    mpv_hls_unlock();
+}
+
+static void mpv_hls_set_speed(double speed) {
+    char cmd[128];
+    snprintf(cmd, sizeof(cmd), "[\"set_property\",\"speed\",%.3f]", speed);
+    mpv_hls_lock();
+    mpv_hls_cmd(cmd, NULL, 0);
+    mpv_hls_unlock();
+}
+
+/* find the id of the first track of the given type ("audio" or "sub") whose language starts with the first two letters of
+   lang (any track if lang is empty); returns -1 if none. json is mpv's reply to get_property track-list. */
+static int mpv_hls_find_track(const char *json, const char *type, const char *lang) {
+    char want_type[32];
+    snprintf(want_type, sizeof(want_type), "\"type\":\"%s\"", type);
+    const char *p = json;
+    while ((p = strstr(p, "{\"id\":")) != NULL) {
+        const char *next = strstr(p + 6, "{\"id\":");
+        size_t len = next ? (size_t) (next - p) : strlen(p);
+        char obj[2048];
+        if (len >= sizeof(obj)) len = sizeof(obj) - 1;
+        memcpy(obj, p, len);
+        obj[len] = '\0';
+        if (strstr(obj, want_type)) {
+            bool ok = true;
+            if (lang && lang[0] && strcmp(lang, "und")) {
+                char key[16];
+                const char *l = strstr(obj, "\"lang\":\"");
+                snprintf(key, sizeof(key), "%.2s", lang);
+                ok = l && !_strnicmp(l + 8, key, 2);
+            }
+            if (ok) return atoi(p + 6);
+        }
+        p += 6;
+    }
+    return -1;
+}
+
+static void mpv_hls_select_media(int sub_on, const char *sub_lang, const char *audio_lang) {
+    static char reply[65536];
+    mpv_hls_lock();
+    if (mpv_hls_cmd("[\"get_property\",\"track-list\"]", reply, sizeof(reply))) {
+        char cmd[96];
+        if (audio_lang && audio_lang[0] && strcmp(audio_lang, "und")) {
+            int id = mpv_hls_find_track(reply, "audio", audio_lang);
+            if (id > 0) {
+                snprintf(cmd, sizeof(cmd), "[\"set_property\",\"aid\",%d]", id);
+                mpv_hls_cmd(cmd, NULL, 0);
+            }
+        }
+        if (sub_on) {
+            int id = mpv_hls_find_track(reply, "sub", sub_lang);
+            if (id < 0) id = mpv_hls_find_track(reply, "sub", NULL);
+            if (id > 0) {
+                snprintf(cmd, sizeof(cmd), "[\"set_property\",\"sid\",%d]", id);
+                mpv_hls_cmd(cmd, NULL, 0);
+                mpv_hls_cmd("[\"set_property\",\"sub-visibility\",true]", NULL, 0);
+            }
+        } else {
+            mpv_hls_cmd("[\"set_property\",\"sid\",\"no\"]", NULL, 0);
+        }
+    }
+    mpv_hls_unlock();
+}
+
+static void mpv_hls_set_volume(double volume_0_to_1) {
+    char cmd[128];
+    snprintf(cmd, sizeof(cmd), "[\"set_property\",\"volume\",%.1f]", volume_0_to_1 * 100.0);
+    mpv_hls_lock();
+    mpv_hls_cmd(cmd, NULL, 0);
+    mpv_hls_unlock();
+}
+
+/* Returns false once the video has finished (mpv idle) or mpv has exited (window closed). */
+static bool mpv_hls_info(double *duration, double *position, bool *paused, bool *buffering) {
+    mpv_hls_lock();
+    bool alive = mpv_hls_alive() && mpv_pipe != INVALID_HANDLE_VALUE;
+    if (alive) {
+        bool idle = false;
+        bool got_idle = mpv_hls_get_bool("idle-active", &idle);
+        if (got_idle && !idle) mpv_seen_file = true;
+        if (got_idle && idle && !mpv_seen_file && (GetTickCount() - mpv_load_tick) < 30000) {
+            /* the loadfile command has not been processed yet / the stream is still being opened: not "finished" */
+        } else if (got_idle && idle) {
+            alive = false;
+        } else {
+            double d = 0, p = -1;
+            bool b = false, pz = false;
+            if (mpv_hls_get_number("duration", &d)) *duration = d;
+            if (mpv_hls_get_number("time-pos", &p)) *position = p;
+            if (mpv_hls_get_bool("pause", &pz)) *paused = pz;
+            if (mpv_hls_get_bool("paused-for-cache", &b)) *buffering = b;
+        }
+    }
+    mpv_hls_unlock();
+    return alive;
+}
+
+#else  /* not Windows: backend unavailable */
+
+static bool mpv_hls_available(void) { return false; }
+static void mpv_hls_set_wid(uintptr_t wid) { (void) wid; }
+static bool mpv_hls_alive(void) { return false; }
+static bool mpv_hls_start(const char *url, double start_pos, bool fullscreen, double volume, const char *title) { (void) url; (void) start_pos; (void) fullscreen; (void) volume; (void) title; return false; }
+static void mpv_hls_stop(void) {}
+static void mpv_hls_set_pause(bool pause) { (void) pause; }
+static void mpv_hls_seek(double position) { (void) position; }
+static void mpv_hls_set_volume(double v) { (void) v; }
+static void mpv_hls_set_speed(double s) { (void) s; }
+static void mpv_hls_select_media(int a, const char *b, const char *c) { (void) a; (void) b; (void) c; }
+static bool mpv_hls_info(double *duration, double *position, bool *paused, bool *buffering) { (void) duration; (void) position; (void) paused; (void) buffering; return false; }
+
+#endif
+#endif /* MPV_HLS_H */
diff --git a/renderers/rm_update.h b/renderers/rm_update.h
new file mode 100644
index 0000000..fc835c0
--- /dev/null
+++ b/renderers/rm_update.h
@@ -0,0 +1,200 @@
+/*
+ * Rubenchik Mirror: in-app updater (Windows only, header-only).
+ *
+ * Every few hours it asks GitHub for the latest release. If it is newer than this build, the window shows an
+ * "Update vX.Y.Z" button. Clicking it downloads RubenchikMirror-Setup.exe from that release, verifies the SHA-256 against the
+ * checksum file published with the release, and starts the installer silently (Windows asks for administrator approval once).
+ * The installer restarts the app when it is done. curl.exe (shipped with Windows 10/11) does the downloads.
+ *
+ * License: GPL-3.0-or-later (same as UxPlay).
+ */
+#ifndef RM_UPDATE_H
+#define RM_UPDATE_H
+
+#ifdef _WIN32
+#include <windows.h>
+#include <shellapi.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+#ifdef __has_include
+#  if __has_include("rm_version.h")
+#    include "rm_version.h"
+#  endif
+#endif
+#ifndef RM_VERSION
+#  define RM_VERSION "0.0.0-dev"
+#endif
+#define RM_REPO "OlegRubenchik/rubenchik-mirror"
+
+static char rm_upd_tag[40] = "";
+static volatile LONG rm_upd_busy = 0;
+
+/* run a command line without a window and wait for it */
+static bool rm_upd_run(const char *cmd, DWORD timeout_ms) {
+    char line[2048];
+    snprintf(line, sizeof(line), "%s", cmd);
+    STARTUPINFOA si;
+    PROCESS_INFORMATION pi;
+    memset(&si, 0, sizeof(si));
+    si.cb = sizeof(si);
+    memset(&pi, 0, sizeof(pi));
+    if (!CreateProcessA(NULL, line, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi)) return false;
+    DWORD w = WaitForSingleObject(pi.hProcess, timeout_ms);
+    DWORD code = 1;
+    if (w == WAIT_OBJECT_0) GetExitCodeProcess(pi.hProcess, &code); else TerminateProcess(pi.hProcess, 1);
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    return w == WAIT_OBJECT_0 && code == 0;
+}
+
+static bool rm_upd_read(const char *path, char *buf, size_t n) {
+    FILE *f = fopen(path, "rb");
+    if (!f) return false;
+    size_t r = fread(buf, 1, n - 1, f);
+    buf[r] = '\0';
+    fclose(f);
+    return r > 0;
+}
+
+static bool rm_upd_download(const char *url, const char *out) {
+    char cmd[1536];
+    snprintf(cmd, sizeof(cmd),
+             "curl.exe -sSL --fail --max-time 600 -H \"User-Agent: RubenchikMirror-updater\" -o \"%s\" \"%s\"", out, url);
+    return rm_upd_run(cmd, 620000);
+}
+
+static void rm_upd_parse(const char *s, int v[3]) {
+    v[0] = v[1] = v[2] = 0;
+    if (*s == 'v' || *s == 'V') s++;
+    sscanf(s, "%d.%d.%d", &v[0], &v[1], &v[2]);
+}
+
+static bool rm_upd_is_newer(const char *tag) {
+    int a[3], b[3];
+    rm_upd_parse(tag, a);
+    rm_upd_parse(RM_VERSION, b);
+    if (b[0] == 0 && b[1] == 0 && b[2] == 0) return false;   /* development build: never nag */
+    for (int i = 0; i < 3; i++) {
+        if (a[i] != b[i]) return a[i] > b[i];
+    }
+    return false;
+}
+
+static void rm_upd_check_once(void) {
+    char tmp[MAX_PATH], file[MAX_PATH + 40], url[256], buf[16384];
+    if (!GetTempPathA(sizeof(tmp), tmp)) return;
+    snprintf(file, sizeof(file), "%srubenchik-latest.json", tmp);
+    snprintf(url, sizeof(url), "https://api.github.com/repos/%s/releases/latest", RM_REPO);
+    if (!rm_upd_download(url, file)) return;
+    if (!rm_upd_read(file, buf, sizeof(buf))) return;
+    DeleteFileA(file);
+    char *t = strstr(buf, "\"tag_name\"");
+    if (!t) return;
+    t = strchr(t + 10, ':');
+    if (!t) return;
+    t = strchr(t, '"');
+    if (!t) return;
+    t++;
+    char *e = strchr(t, '"');
+    if (!e || e - t >= (int) sizeof(rm_upd_tag)) return;
+    char tag[40];
+    memcpy(tag, t, e - t);
+    tag[e - t] = '\0';
+    if (rm_upd_is_newer(tag)) {
+        snprintf(rm_upd_tag, sizeof(rm_upd_tag), "%s", tag);
+    }
+}
+
+static void rm_upd_click(void);
+
+static DWORD WINAPI rm_upd_checker(LPVOID arg) {
+    (void) arg;
+    Sleep(15000);
+    for (;;) {
+        if (!rm_upd_busy) {
+            rm_upd_check_once();
+            if (rm_upd_tag[0]) {
+                char label[64];
+                snprintf(label, sizeof(label), "Update %s", rm_upd_tag);
+                rm_ui_set_update(label, rm_upd_click);
+            }
+        }
+        Sleep(6 * 3600 * 1000);
+    }
+    return 0;
+}
+
+static DWORD WINAPI rm_upd_installer(LPVOID arg) {
+    (void) arg;
+    char tmp[MAX_PATH], exe[MAX_PATH + 64], sha[MAX_PATH + 64], url[512], url_sha[512];
+    GetTempPathA(sizeof(tmp), tmp);
+    snprintf(exe, sizeof(exe), "%sRubenchikMirror-Setup-%s.exe", tmp, rm_upd_tag);
+    snprintf(sha, sizeof(sha), "%sRubenchikMirror-Setup-%s.sha256", tmp, rm_upd_tag);
+    snprintf(url, sizeof(url), "https://github.com/%s/releases/download/%s/RubenchikMirror-Setup.exe", RM_REPO, rm_upd_tag);
+    snprintf(url_sha, sizeof(url_sha), "https://github.com/%s/releases/download/%s/RubenchikMirror-Setup.exe.sha256", RM_REPO, rm_upd_tag);
+
+    rm_ui_set_update("Downloading...", NULL);
+    if (!rm_upd_download(url, exe) || !rm_upd_download(url_sha, sha)) {
+        rm_ui_set_update("Update failed - retry", rm_upd_click);
+        InterlockedExchange(&rm_upd_busy, 0);
+        return 0;
+    }
+    /* verify SHA-256 with certutil (part of Windows) */
+    char want[200] = "", out[MAX_PATH + 64], cmd[1024], got_txt[2048] = "";
+    rm_upd_read(sha, want, sizeof(want));
+    snprintf(out, sizeof(out), "%shash.txt", tmp);
+    snprintf(cmd, sizeof(cmd), "cmd.exe /c certutil -hashfile \"%s\" SHA256 > \"%s\"", exe, out);
+    bool ok = rm_upd_run(cmd, 120000) && rm_upd_read(out, got_txt, sizeof(got_txt));
+    DeleteFileA(out);
+    if (ok) {
+        /* second line of certutil output is the hash (spaces allowed between bytes on old systems) */
+        char *nl = strchr(got_txt, '\n');
+        char hash[80] = "";
+        if (nl) {
+            int j = 0;
+            for (char *p = nl + 1; *p && *p != '\n' && j < 70; p++) {
+                if (isxdigit((unsigned char) *p)) hash[j++] = (char) tolower((unsigned char) *p);
+            }
+            hash[j] = '\0';
+        }
+        char wanth[80] = "";
+        int k = 0;
+        for (char *p = want; *p && k < 64 && isxdigit((unsigned char) *p); p++) wanth[k++] = (char) tolower((unsigned char) *p);
+        wanth[k] = '\0';
+        ok = (strlen(hash) == 64 && strcmp(hash, wanth) == 0);
+    }
+    if (!ok) {
+        DeleteFileA(exe);
+        rm_ui_set_update("Checksum mismatch", rm_upd_click);
+        InterlockedExchange(&rm_upd_busy, 0);
+        return 0;
+    }
+    rm_ui_set_update("Installing...", NULL);
+    /* run elevated (UAC prompt); the installer stops this app, updates it and starts it again */
+    HINSTANCE r = ShellExecuteA(NULL, "runas", exe, "/SILENT /NORESTART /SUPPRESSMSGBOXES", NULL, SW_SHOWNORMAL);
+    if ((INT_PTR) r <= 32) {
+        rm_ui_set_update("Update cancelled - retry", rm_upd_click);
+        InterlockedExchange(&rm_upd_busy, 0);
+    }
+    return 0;
+}
+
+static void rm_upd_click(void) {
+    if (!rm_upd_tag[0] || InterlockedExchange(&rm_upd_busy, 1)) return;
+    HANDLE th = CreateThread(NULL, 0, rm_upd_installer, NULL, 0, NULL);
+    if (th) CloseHandle(th); else InterlockedExchange(&rm_upd_busy, 0);
+}
+
+static void rm_update_start(void) {
+    if (getenv("RUBENCHIK_NO_UPDATE_CHECK")) return;
+    HANDLE th = CreateThread(NULL, 0, rm_upd_checker, NULL, 0, NULL);
+    if (th) CloseHandle(th);
+}
+
+#else
+static void rm_update_start(void) {}
+#endif
+#endif /* RM_UPDATE_H */
diff --git a/renderers/rm_window.h b/renderers/rm_window.h
new file mode 100644
index 0000000..7bd81d6
--- /dev/null
+++ b/renderers/rm_window.h
@@ -0,0 +1,785 @@
+/*
+ * Rubenchik Mirror: branded host window (Windows only, header-only).
+ *
+ * One minimal window with a custom title bar (minimize / fullscreen / close, drag to move, resize from the edges),
+ * a logo "waiting" screen, and a child surface into which the video renderers draw:
+ *   - GStreamer sinks (screen mirroring) through GstVideoOverlay, see video_renderer_set_window_handle();
+ *   - mpv (YouTube / HLS) through --wid.
+ *
+ * License: GPL-3.0-or-later (same as UxPlay).
+ */
+#ifndef RM_WINDOW_H
+#define RM_WINDOW_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <windowsx.h>
+
+#define RM_TITLE_H   38
+#define RM_BTN_W     46
+#define RM_RESIZE_B  6
+
+#define RM_COL_BG      RGB(0x0B, 0x0D, 0x10)
+#define RM_COL_BAR     RGB(0x14, 0x17, 0x1C)
+#define RM_COL_TEXT    RGB(0xE6, 0xE8, 0xEB)
+#define RM_COL_MUTED   RGB(0x8A, 0x93, 0x9E)
+#define RM_COL_GREEN   RGB(0x4A, 0xDE, 0x80)
+#define RM_COL_HOVER   RGB(0x25, 0x2A, 0x31)
+#define RM_COL_CLOSE   RGB(0xE5, 0x48, 0x4D)
+
+/* returns 0: idle (waiting), 1: mirroring the screen, 2: playing a video (YouTube) */
+typedef int (*rm_state_fn)(void);
+typedef void (*rm_close_fn)(void);
+
+static HWND rm_host = NULL;
+static HWND rm_video = NULL;
+static HBITMAP rm_logo = NULL;
+static int rm_logo_w = 0, rm_logo_h = 0;
+static HICON rm_icon_big = NULL, rm_icon_small = NULL;
+static HFONT rm_font_title = NULL, rm_font_small = NULL, rm_font_hint = NULL;
+static bool rm_is_fullscreen = false;
+static bool rm_auto_fullscreen = false;
+static WINDOWPLACEMENT rm_saved_placement;
+static int rm_hover = 0;            /* 0 none, 1 minimize, 2 fullscreen, 3 close */
+static bool rm_tracking = false;
+static int rm_state_now = -1;
+static rm_state_fn rm_state_cb = NULL;
+static rm_close_fn rm_close_cb = NULL;
+static HANDLE rm_ready_event = NULL;
+static char rm_logo_path[MAX_PATH + 32];
+static char rm_icon_path[MAX_PATH + 32];
+static char rm_update_label[64] = "";      /* text of the "update available" button; empty = no button */
+static void (*rm_update_cb)(void) = NULL;  /* called when the button is clicked (NULL: busy, not clickable) */
+static int rm_update_w = 0;                /* button width, measured when painting */
+
+#define RM_MSG_PROMPT         (WM_APP + 1)   /* wParam: 1 = first-run name prompt, 2 = rename */
+#define RM_MSG_PROMPT_OK      (WM_APP + 2)
+#define RM_MSG_PROMPT_CANCEL  (WM_APP + 3)
+#define RM_MSG_PIN            (WM_APP + 4)
+
+static int rm_prompt = 0;                    /* 0: none, 1: asking the device name (first run), 2: renaming */
+static HWND rm_edit = NULL;
+static WNDPROC rm_edit_old = NULL;
+static HANDLE rm_name_event = NULL;
+static wchar_t rm_name_result[64] = L"";
+static wchar_t rm_prompt_initial[64] = L"";
+static wchar_t rm_device_name[64] = L"";     /* shown in the title bar; click it to rename */
+static int rm_name_w = 0;
+static HFONT rm_font_big = NULL, rm_font_pin = NULL, rm_font_edit = NULL;
+static HBRUSH rm_brush_edit = NULL;
+static void (*rm_rename_cb)(const wchar_t *name) = NULL;
+static char rm_pin[16] = "";                 /* pairing code to show on the idle screen */
+static DWORD rm_pin_tick = 0;
+
+static int rm_title_h(void) { return rm_is_fullscreen ? 0 : RM_TITLE_H; }
+
+static void rm_ui_set_update(const char *label, void (*cb)(void)) {
+    snprintf(rm_update_label, sizeof(rm_update_label), "%s", label ? label : "");
+    rm_update_cb = cb;
+    if (rm_host) InvalidateRect(rm_host, NULL, FALSE);
+}
+
+static RECT rm_update_rect(int width) {
+    RECT r;
+    r.right = width - 3 * RM_BTN_W - 12;
+    r.left = r.right - rm_update_w;
+    r.top = 7;
+    r.bottom = RM_TITLE_H - 7;
+    return r;
+}
+
+static bool rm_in_update(int x, int y, int width) {
+    if (rm_is_fullscreen || !rm_update_label[0] || rm_update_w <= 0) return false;
+    RECT r = rm_update_rect(width);
+    return x >= r.left && x < r.right && y >= r.top && y < r.bottom;
+}
+
+#define RM_EDIT_W 380
+#define RM_EDIT_H 38
+
+static void rm_prompt_rects(int width, int height, RECT *edit, RECT *btn, int *title_y) {
+    int th = rm_title_h();
+    int cx = width / 2, cy = th + (height - th) / 2;
+    edit->left = cx - RM_EDIT_W / 2;
+    edit->right = edit->left + RM_EDIT_W;
+    edit->top = cy - 8;
+    edit->bottom = edit->top + RM_EDIT_H;
+    btn->left = cx - 70;
+    btn->right = cx + 70;
+    btn->top = edit->bottom + 24;
+    btn->bottom = btn->top + 38;
+    *title_y = cy - 140;
+}
+
+static void rm_layout_edit(void) {
+    if (!rm_edit || !rm_host) return;
+    RECT cr, e, b;
+    int ty;
+    GetClientRect(rm_host, &cr);
+    rm_prompt_rects(cr.right, cr.bottom, &e, &b, &ty);
+    MoveWindow(rm_edit, e.left, e.top, e.right - e.left, e.bottom - e.top, TRUE);
+}
+
+static void rm_refresh_video(void) {
+    if (rm_video) ShowWindow(rm_video, (rm_state_now > 0 && !rm_prompt) ? SW_SHOWNA : SW_HIDE);
+}
+
+/* the device-name pill in the title bar (left of the update button) */
+static RECT rm_name_rect(int width) {
+    RECT r;
+    r.right = ((rm_update_label[0] && rm_update_w > 0) ? rm_update_rect(width).left : width - 3 * RM_BTN_W - 12) - 8;
+    r.left = r.right - rm_name_w;
+    r.top = 7;
+    r.bottom = RM_TITLE_H - 7;
+    return r;
+}
+
+static bool rm_in_name(int x, int y, int width) {
+    if (rm_is_fullscreen || !rm_device_name[0] || rm_name_w <= 0) return false;
+    RECT r = rm_name_rect(width);
+    if (r.left < 300) return false;
+    return x >= r.left && x < r.right && y >= r.top && y < r.bottom;
+}
+
+static void rm_layout(void) {
+    if (!rm_host || !rm_video) return;
+    RECT cr;
+    GetClientRect(rm_host, &cr);
+    int th = rm_title_h();
+    MoveWindow(rm_video, 0, th, cr.right, cr.bottom - th > 0 ? cr.bottom - th : 0, TRUE);
+    rm_layout_edit();
+}
+
+static RECT rm_button_rect(int which, int width) {   /* which: 1 minimize, 2 fullscreen, 3 close */
+    RECT r;
+    r.right = width - (3 - which) * RM_BTN_W;
+    r.left = r.right - RM_BTN_W;
+    r.top = 0;
+    r.bottom = RM_TITLE_H;
+    return r;
+}
+
+static int rm_button_at(int x, int y, int width) {
+    if (rm_is_fullscreen || y < 0 || y >= RM_TITLE_H) return 0;
+    for (int i = 1; i <= 3; i++) {
+        RECT r = rm_button_rect(i, width);
+        if (x >= r.left && x < r.right) return i;
+    }
+    return 0;
+}
+
+static void rm_set_fullscreen(bool on) {
+    if (!rm_host || on == rm_is_fullscreen) return;
+    if (on) {
+        rm_saved_placement.length = sizeof(rm_saved_placement);
+        GetWindowPlacement(rm_host, &rm_saved_placement);
+        MONITORINFO mi;
+        mi.cbSize = sizeof(mi);
+        GetMonitorInfo(MonitorFromWindow(rm_host, MONITOR_DEFAULTTONEAREST), &mi);
+        rm_is_fullscreen = true;
+        SetWindowPos(rm_host, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top, mi.rcMonitor.right - mi.rcMonitor.left,
+                     mi.rcMonitor.bottom - mi.rcMonitor.top, SWP_FRAMECHANGED | SWP_SHOWWINDOW);
+    } else {
+        rm_is_fullscreen = false;
+        SetWindowPlacement(rm_host, &rm_saved_placement);
+        SetWindowPos(rm_host, NULL, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_FRAMECHANGED);
+    }
+    rm_layout();
+    InvalidateRect(rm_host, NULL, FALSE);
+}
+
+static void rm_draw_button_glyph(HDC dc, int which, RECT r, COLORREF col) {
+    HPEN pen = CreatePen(PS_SOLID, 1, col);
+    HPEN old = (HPEN) SelectObject(dc, pen);
+    int cx = (r.left + r.right) / 2, cy = (r.top + r.bottom) / 2;
+    if (which == 1) {                         /* minimize: line */
+        MoveToEx(dc, cx - 5, cy + 1, NULL); LineTo(dc, cx + 6, cy + 1);
+    } else if (which == 2) {                  /* fullscreen: square (or two squares when already fullscreen) */
+        HBRUSH nb = (HBRUSH) GetStockObject(NULL_BRUSH);
+        HBRUSH ob = (HBRUSH) SelectObject(dc, nb);
+        Rectangle(dc, cx - 5, cy - 5, cx + 6, cy + 6);
+        SelectObject(dc, ob);
+    } else {                                  /* close: cross */
+        MoveToEx(dc, cx - 5, cy - 5, NULL); LineTo(dc, cx + 6, cy + 6);
+        MoveToEx(dc, cx + 5, cy - 5, NULL); LineTo(dc, cx - 6, cy + 6);
+    }
+    SelectObject(dc, old);
+    DeleteObject(pen);
+}
+
+static void rm_paint(HWND hwnd) {
+    PAINTSTRUCT ps;
+    HDC wdc = BeginPaint(hwnd, &ps);
+    RECT cr;
+    GetClientRect(hwnd, &cr);
+    HDC dc = CreateCompatibleDC(wdc);
+    HBITMAP bmp = CreateCompatibleBitmap(wdc, cr.right, cr.bottom);
+    HBITMAP oldbmp = (HBITMAP) SelectObject(dc, bmp);
+    SetBkMode(dc, TRANSPARENT);
+
+    HBRUSH bg = CreateSolidBrush(RM_COL_BG);
+    FillRect(dc, &cr, bg);
+    DeleteObject(bg);
+
+    int th = rm_title_h();
+    if (th) {
+        RECT bar = {0, 0, cr.right, th};
+        HBRUSH bb = CreateSolidBrush(RM_COL_BAR);
+        FillRect(dc, &bar, bb);
+        DeleteObject(bb);
+        if (rm_icon_small) DrawIconEx(dc, 12, (th - 20) / 2, rm_icon_small, 20, 20, 0, NULL, DI_NORMAL);
+        SelectObject(dc, rm_font_title);
+        SetTextColor(dc, RM_COL_TEXT);
+        TextOutA(dc, 42, (th - 18) / 2, "Rubenchik Mirror", 16);
+        SIZE sz;
+        GetTextExtentPoint32A(dc, "Rubenchik Mirror", 16, &sz);
+        const char *status = rm_state_now == 1 ? "Mirroring" : rm_state_now == 2 ? "Playing video" : "Ready";
+        SelectObject(dc, rm_font_small);
+        SetTextColor(dc, rm_state_now > 0 ? RM_COL_GREEN : RM_COL_MUTED);
+        TextOutA(dc, 42 + sz.cx + 14, (th - 16) / 2 + 1, status, (int) strlen(status));
+        if (rm_update_label[0]) {
+            SelectObject(dc, rm_font_small);
+            SIZE us;
+            GetTextExtentPoint32A(dc, rm_update_label, (int) strlen(rm_update_label), &us);
+            rm_update_w = us.cx + 28;
+            RECT ur = rm_update_rect(cr.right);
+            HBRUSH gb = CreateSolidBrush(rm_update_cb ? RM_COL_GREEN : RM_COL_HOVER);
+            HPEN gp = CreatePen(PS_SOLID, 1, rm_update_cb ? RM_COL_GREEN : RM_COL_HOVER);
+            HBRUSH ogb = (HBRUSH) SelectObject(dc, gb);
+            HPEN ogp = (HPEN) SelectObject(dc, gp);
+            RoundRect(dc, ur.left, ur.top, ur.right, ur.bottom, 12, 12);
+            SelectObject(dc, ogb);
+            SelectObject(dc, ogp);
+            DeleteObject(gb);
+            DeleteObject(gp);
+            SetTextColor(dc, rm_update_cb ? RM_COL_BG : RM_COL_TEXT);
+            TextOutA(dc, ur.left + 14, ur.top + ((ur.bottom - ur.top) - us.cy) / 2, rm_update_label, (int) strlen(rm_update_label));
+        }
+        if (rm_device_name[0]) {
+            SelectObject(dc, rm_font_small);
+            SIZE ns;
+            GetTextExtentPoint32W(dc, rm_device_name, (int) wcslen(rm_device_name), &ns);
+            rm_name_w = ns.cx + 28;
+            RECT nr = rm_name_rect(cr.right);
+            if (nr.left >= 300) {
+                HBRUSH nb = CreateSolidBrush(RM_COL_HOVER);
+                HPEN np = CreatePen(PS_SOLID, 1, RM_COL_HOVER);
+                HBRUSH onb = (HBRUSH) SelectObject(dc, nb);
+                HPEN onp = (HPEN) SelectObject(dc, np);
+                RoundRect(dc, nr.left, nr.top, nr.right, nr.bottom, 12, 12);
+                SelectObject(dc, onb);
+                SelectObject(dc, onp);
+                DeleteObject(nb);
+                DeleteObject(np);
+                SetTextColor(dc, RM_COL_TEXT);
+                TextOutW(dc, nr.left + 14, nr.top + ((nr.bottom - nr.top) - ns.cy) / 2, rm_device_name, (int) wcslen(rm_device_name));
+            }
+        }
+        for (int i = 1; i <= 3; i++) {
+            RECT r = rm_button_rect(i, cr.right);
+            if (rm_hover == i) {
+                HBRUSH hb = CreateSolidBrush(i == 3 ? RM_COL_CLOSE : RM_COL_HOVER);
+                FillRect(dc, &r, hb);
+                DeleteObject(hb);
+            }
+            rm_draw_button_glyph(dc, i, r, RM_COL_TEXT);
+        }
+    }
+
+    if (rm_prompt) {
+        RECT er, br;
+        int ty;
+        rm_prompt_rects(cr.right, cr.bottom, &er, &br, &ty);
+        RECT tr = {0, ty, cr.right, ty + 44};
+        SelectObject(dc, rm_font_big);
+        SetTextColor(dc, RM_COL_TEXT);
+        DrawTextW(dc, rm_prompt == 1 ? L"Name this receiver" : L"Rename this receiver", -1, &tr, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+        SelectObject(dc, rm_font_hint);
+        SetTextColor(dc, RM_COL_MUTED);
+        RECT s1 = {0, ty + 56, cr.right, ty + 80};
+        DrawTextW(dc, L"This is how it appears on your iPhone in the Screen Mirroring list.", -1, &s1, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+        RECT s2 = {0, ty + 82, cr.right, ty + 106};
+        DrawTextW(dc, L"Give every PC its own name, for example Living Room or Bedroom.", -1, &s2, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+        HBRUSH gb = CreateSolidBrush(RM_COL_GREEN);
+        HPEN gp = CreatePen(PS_SOLID, 1, RM_COL_GREEN);
+        HBRUSH ogb = (HBRUSH) SelectObject(dc, gb);
+        HPEN ogp = (HPEN) SelectObject(dc, gp);
+        RoundRect(dc, br.left, br.top, br.right, br.bottom, 16, 16);
+        SelectObject(dc, ogb);
+        SelectObject(dc, ogp);
+        DeleteObject(gb);
+        DeleteObject(gp);
+        SelectObject(dc, rm_font_title);
+        SetTextColor(dc, RM_COL_BG);
+        DrawTextW(dc, rm_prompt == 1 ? L"Start" : L"Save", -1, &br, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+        if (rm_prompt == 2) {
+            SelectObject(dc, rm_font_small);
+            SetTextColor(dc, RM_COL_MUTED);
+            RECT esc = {0, br.bottom + 12, cr.right, br.bottom + 34};
+            DrawTextW(dc, L"Esc to cancel. The app restarts to apply the new name.", -1, &esc, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+        }
+    } else if (rm_state_now <= 0) {
+        RECT area = {0, th, cr.right, cr.bottom};
+        int aw = area.right - area.left, ah = area.bottom - area.top;
+        if (rm_logo && rm_logo_w > 0 && aw > 100 && ah > 100) {
+            /* logo scaled to at most 46% of the width / 50% of the height, centered slightly above the middle */
+            double s1 = (aw * 0.46) / rm_logo_w, s2 = (ah * 0.50) / rm_logo_h;
+            double sc = s1 < s2 ? s1 : s2;
+            if (sc > 1.0) sc = 1.0;
+            int w = (int) (rm_logo_w * sc), h = (int) (rm_logo_h * sc);
+            int x = area.left + (aw - w) / 2, y = area.top + (ah - h) / 2 - ah / 12;
+            HDC mem = CreateCompatibleDC(dc);
+            HBITMAP ob = (HBITMAP) SelectObject(mem, rm_logo);
+            SetStretchBltMode(dc, HALFTONE);
+            SetBrushOrgEx(dc, 0, 0, NULL);
+            StretchBlt(dc, x, y, w, h, mem, 0, 0, rm_logo_w, rm_logo_h, SRCCOPY);
+            SelectObject(mem, ob);
+            DeleteDC(mem);
+            SelectObject(dc, rm_font_hint);
+            SetTextColor(dc, RM_COL_MUTED);
+            if (rm_pin[0] && (GetTickCount() - rm_pin_tick) < 180000) {
+                wchar_t digits[48] = L"";
+                int j = 0;
+                for (int k = 0; rm_pin[k] && j < 40; k++) {
+                    digits[j++] = (wchar_t) rm_pin[k];
+                    if (rm_pin[k + 1]) digits[j++] = L' ';
+                }
+                digits[j] = 0;
+                RECT l1 = {area.left, y + h + 14, area.right, y + h + 40};
+                DrawTextW(dc, L"Enter this code on your iPhone", -1, &l1, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+                SelectObject(dc, rm_font_pin);
+                SetTextColor(dc, RM_COL_GREEN);
+                RECT l2 = {area.left, y + h + 40, area.right, y + h + 130};
+                DrawTextW(dc, digits, -1, &l2, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+            } else {
+                wchar_t hint[200];
+                _snwprintf(hint, 200, L"On your iPhone: Control Center  >  Screen Mirroring  >  %ls",
+                           rm_device_name[0] ? rm_device_name : L"Rubenchik Mirror");
+                RECT l1 = {area.left, y + h + 22, area.right, y + h + 46};
+                DrawTextW(dc, hint, -1, &l1, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+                RECT l2 = {area.left, y + h + 46, area.right, y + h + 70};
+                DrawTextW(dc, L"YouTube: tap the AirPlay icon in the YouTube app", -1, &l2, DT_CENTER | DT_SINGLELINE | DT_VCENTER);
+            }
+        }
+    }
+
+    BitBlt(wdc, 0, 0, cr.right, cr.bottom, dc, 0, 0, SRCCOPY);
+    SelectObject(dc, oldbmp);
+    DeleteObject(bmp);
+    DeleteDC(dc);
+    EndPaint(hwnd, &ps);
+}
+
+static void rm_apply_state(int st) {
+    if (st == rm_state_now) return;
+    int prev = rm_state_now;
+    rm_state_now = st;
+    rm_refresh_video();
+    if (st > 0) rm_pin[0] = 0;
+    if (st > 0 && prev <= 0 && rm_auto_fullscreen && !rm_is_fullscreen) rm_set_fullscreen(true);
+    if (rm_host) {
+        SetWindowTextA(rm_host, st == 1 ? "Rubenchik Mirror - Mirroring" : st == 2 ? "Rubenchik Mirror - Playing" : "Rubenchik Mirror");
+        InvalidateRect(rm_host, NULL, FALSE);
+    }
+}
+
+static LRESULT CALLBACK rm_edit_proc(HWND h, UINT m, WPARAM w, LPARAM l) {
+    if ((m == WM_KEYDOWN || m == WM_CHAR) && w == VK_RETURN) {
+        if (m == WM_KEYDOWN) PostMessage(rm_host, RM_MSG_PROMPT_OK, 0, 0);
+        return 0;
+    }
+    if ((m == WM_KEYDOWN || m == WM_CHAR) && w == VK_ESCAPE) {
+        if (m == WM_KEYDOWN) PostMessage(rm_host, RM_MSG_PROMPT_CANCEL, 0, 0);
+        return 0;
+    }
+    return CallWindowProcW(rm_edit_old, h, m, w, l);
+}
+
+static void rm_prompt_begin(int mode) {
+    rm_prompt = mode;
+    if (!rm_edit) {
+        rm_edit = CreateWindowExW(0, L"EDIT", L"", WS_CHILD | WS_BORDER | ES_AUTOHSCROLL, 0, 0, 10, 10, rm_host, NULL,
+                                  GetModuleHandle(NULL), NULL);
+        SendMessageW(rm_edit, WM_SETFONT, (WPARAM) rm_font_edit, TRUE);
+        SendMessageW(rm_edit, EM_LIMITTEXT, 40, 0);
+        rm_edit_old = (WNDPROC) SetWindowLongPtrW(rm_edit, GWLP_WNDPROC, (LONG_PTR) rm_edit_proc);
+    }
+    SetWindowTextW(rm_edit, rm_prompt_initial);
+    rm_layout_edit();
+    ShowWindow(rm_edit, SW_SHOW);
+    SendMessageW(rm_edit, EM_SETSEL, 0, -1);
+    SetFocus(rm_edit);
+    rm_refresh_video();
+    if (IsIconic(rm_host)) ShowWindow(rm_host, SW_RESTORE);
+    InvalidateRect(rm_host, NULL, FALSE);
+}
+
+static void rm_prompt_end(void) {
+    rm_prompt = 0;
+    if (rm_edit) ShowWindow(rm_edit, SW_HIDE);
+    rm_refresh_video();
+    SetFocus(rm_host);
+    InvalidateRect(rm_host, NULL, FALSE);
+}
+
+static void rm_prompt_confirm(void) {
+    wchar_t buf[64] = L"";
+    if (rm_edit) GetWindowTextW(rm_edit, buf, 64);
+    size_t n = wcslen(buf);
+    while (n > 0 && (buf[n - 1] == L' ' || buf[n - 1] == L'\t')) buf[--n] = 0;
+    wchar_t *p = buf;
+    while (*p == L' ' || *p == L'\t') p++;
+    if (!*p) {
+        MessageBeep(MB_OK);
+        return;
+    }
+    int mode = rm_prompt;
+    wcsncpy(rm_name_result, p, 63);
+    rm_name_result[63] = 0;
+    wcsncpy(rm_device_name, rm_name_result, 63);
+    rm_device_name[63] = 0;
+    rm_prompt_end();
+    if (mode == 1) {
+        if (rm_name_event) SetEvent(rm_name_event);
+    } else if (rm_rename_cb) {
+        rm_rename_cb(rm_name_result);
+    }
+}
+
+static void rm_prompt_cancel(void) {
+    if (rm_prompt == 2) rm_prompt_end();      /* the first-run prompt cannot be cancelled */
+}
+
+static LRESULT CALLBACK rm_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
+    switch (msg) {
+    case WM_NCCALCSIZE:
+        if (wp) return 0;                      /* no standard frame or caption: we draw our own */
+        break;
+    case WM_NCHITTEST: {
+        POINT pt = {GET_X_LPARAM(lp), GET_Y_LPARAM(lp)};
+        ScreenToClient(hwnd, &pt);
+        RECT cr;
+        GetClientRect(hwnd, &cr);
+        if (!rm_is_fullscreen) {
+            bool l = pt.x < RM_RESIZE_B, r = pt.x >= cr.right - RM_RESIZE_B;
+            bool t = pt.y < RM_RESIZE_B, b = pt.y >= cr.bottom - RM_RESIZE_B;
+            if (t && l) return HTTOPLEFT;
+            if (t && r) return HTTOPRIGHT;
+            if (b && l) return HTBOTTOMLEFT;
+            if (b && r) return HTBOTTOMRIGHT;
+            if (l) return HTLEFT;
+            if (r) return HTRIGHT;
+            if (t) return HTTOP;
+            if (b) return HTBOTTOM;
+            if (pt.y < RM_TITLE_H && rm_button_at(pt.x, pt.y, cr.right) == 0 && !rm_in_update(pt.x, pt.y, cr.right) && !rm_in_name(pt.x, pt.y, cr.right)) return HTCAPTION;
+        }
+        return HTCLIENT;
+    }
+    case WM_GETMINMAXINFO: {
+        MINMAXINFO *mm = (MINMAXINFO *) lp;
+        mm->ptMinTrackSize.x = 640;
+        mm->ptMinTrackSize.y = 400;
+        return 0;
+    }
+    case WM_SIZE:
+        rm_layout();
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_CTLCOLOREDIT: {
+        HDC d = (HDC) wp;
+        SetTextColor(d, RM_COL_TEXT);
+        SetBkColor(d, RM_COL_BAR);
+        return (LRESULT) rm_brush_edit;
+    }
+    case RM_MSG_PROMPT:
+        rm_prompt_begin((int) wp);
+        return 0;
+    case RM_MSG_PROMPT_OK:
+        rm_prompt_confirm();
+        return 0;
+    case RM_MSG_PROMPT_CANCEL:
+        rm_prompt_cancel();
+        return 0;
+    case RM_MSG_PIN:
+        if (IsIconic(hwnd)) ShowWindow(hwnd, SW_RESTORE);
+        {
+            FLASHWINFO fi = {sizeof(fi), hwnd, FLASHW_ALL | FLASHW_TIMERNOFG, 3, 0};
+            FlashWindowEx(&fi);
+        }
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+        rm_paint(hwnd);
+        return 0;
+    case WM_NCACTIVATE:
+        /* lParam -1: do not repaint the (non-existent) frame: avoids the light outline when the window is (de)activated */
+        return DefWindowProc(hwnd, msg, wp, -1);
+    case WM_NCPAINT:
+        return 0;
+    case WM_MOUSEMOVE: {
+        RECT cr;
+        GetClientRect(hwnd, &cr);
+        int h = rm_button_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp), cr.right);
+        if (h != rm_hover) {
+            rm_hover = h;
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        if (!rm_tracking) {
+            TRACKMOUSEEVENT tme = {sizeof(tme), TME_LEAVE, hwnd, 0};
+            TrackMouseEvent(&tme);
+            rm_tracking = true;
+        }
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        rm_tracking = false;
+        if (rm_hover) {
+            rm_hover = 0;
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        return 0;
+    case WM_LBUTTONUP: {
+        RECT cr;
+        GetClientRect(hwnd, &cr);
+        if (rm_in_update(GET_X_LPARAM(lp), GET_Y_LPARAM(lp), cr.right)) {
+            if (rm_update_cb) rm_update_cb();
+            return 0;
+        }
+        if (rm_prompt) {
+            RECT er, br;
+            int ty;
+            rm_prompt_rects(cr.right, cr.bottom, &er, &br, &ty);
+            POINT cp = {GET_X_LPARAM(lp), GET_Y_LPARAM(lp)};
+            if (PtInRect(&br, cp)) PostMessage(hwnd, RM_MSG_PROMPT_OK, 0, 0);
+            return 0;
+        }
+        if (rm_in_name(GET_X_LPARAM(lp), GET_Y_LPARAM(lp), cr.right)) {
+            wcsncpy(rm_prompt_initial, rm_device_name, 63);
+            PostMessage(hwnd, RM_MSG_PROMPT, 2, 0);
+            return 0;
+        }
+        switch (rm_button_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp), cr.right)) {
+        case 1: ShowWindow(hwnd, SW_MINIMIZE); break;
+        case 2: rm_set_fullscreen(!rm_is_fullscreen); break;
+        case 3: PostMessage(hwnd, WM_CLOSE, 0, 0); break;
+        default: break;
+        }
+        return 0;
+    }
+    case WM_LBUTTONDBLCLK:
+        if (rm_button_at(GET_X_LPARAM(lp), GET_Y_LPARAM(lp), 100000) == 0) rm_set_fullscreen(!rm_is_fullscreen);
+        return 0;
+    case WM_NCLBUTTONDBLCLK:
+        if (wp == HTCAPTION) {
+            rm_set_fullscreen(!rm_is_fullscreen);
+            return 0;
+        }
+        break;
+    case WM_KEYDOWN:
+    case WM_SYSKEYDOWN:
+        if (wp == VK_F11 || (wp == VK_RETURN && (GetKeyState(VK_MENU) & 0x8000))) {
+            rm_set_fullscreen(!rm_is_fullscreen);
+            return 0;
+        }
+        if (wp == VK_ESCAPE && rm_is_fullscreen) {
+            rm_set_fullscreen(false);
+            return 0;
+        }
+        break;
+    case WM_TIMER:
+        if (wp == 1 && rm_state_cb) {
+            if (rm_pin[0] && (GetTickCount() - rm_pin_tick) >= 180000) {   /* hide an old pairing code */
+                rm_pin[0] = 0;
+                InvalidateRect(hwnd, NULL, FALSE);
+            }
+            rm_apply_state(rm_state_cb());
+        } else if (wp == 2) {
+            ExitProcess(0);                    /* graceful shutdown did not finish in time */
+        }
+        return 0;
+    case WM_CLOSE:
+        SetTimer(hwnd, 2, 4000, NULL);
+        if (rm_close_cb) rm_close_cb(); else ExitProcess(0);
+        return 0;
+    case WM_DESTROY:
+        PostQuitMessage(0);
+        return 0;
+    default:
+        break;
+    }
+    return DefWindowProc(hwnd, msg, wp, lp);
+}
+
+static LRESULT CALLBACK rm_video_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
+    if (msg == WM_ERASEBKGND) {
+        RECT r;
+        GetClientRect(hwnd, &r);
+        FillRect((HDC) wp, &r, (HBRUSH) GetStockObject(BLACK_BRUSH));
+        return 1;
+    }
+    if (msg == WM_LBUTTONDBLCLK || msg == WM_KEYDOWN || msg == WM_SYSKEYDOWN) {
+        return SendMessage(GetParent(hwnd), msg == WM_LBUTTONDBLCLK ? WM_LBUTTONDBLCLK : msg, wp, lp);
+    }
+    return DefWindowProc(hwnd, msg, wp, lp);
+}
+
+static HFONT rm_make_font(int px, int weight) {
+    return CreateFontA(-px, 0, 0, 0, weight, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
+                       CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, "Segoe UI");
+}
+
+static DWORD WINAPI rm_thread(LPVOID arg) {
+    (void) arg;
+    HINSTANCE inst = GetModuleHandle(NULL);
+    rm_font_title = rm_make_font(15, FW_SEMIBOLD);
+    rm_font_small = rm_make_font(13, FW_NORMAL);
+    rm_font_hint = rm_make_font(15, FW_NORMAL);
+    rm_font_big = rm_make_font(30, FW_SEMIBOLD);
+    rm_font_pin = rm_make_font(76, FW_SEMIBOLD);
+    rm_font_edit = rm_make_font(19, FW_NORMAL);
+    rm_brush_edit = CreateSolidBrush(RM_COL_BAR);
+    rm_icon_big = (HICON) LoadImageA(NULL, rm_icon_path, IMAGE_ICON, 32, 32, LR_LOADFROMFILE);
+    rm_icon_small = (HICON) LoadImageA(NULL, rm_icon_path, IMAGE_ICON, 20, 20, LR_LOADFROMFILE);
+    HBITMAP lb = (HBITMAP) LoadImageA(NULL, rm_logo_path, IMAGE_BITMAP, 0, 0, LR_LOADFROMFILE | LR_CREATEDIBSECTION);
+    if (lb) {
+        BITMAP bm;
+        GetObject(lb, sizeof(bm), &bm);
+        rm_logo = lb;
+        rm_logo_w = bm.bmWidth;
+        rm_logo_h = bm.bmHeight;
+    }
+
+    WNDCLASSEXA wc;
+    memset(&wc, 0, sizeof(wc));
+    wc.cbSize = sizeof(wc);
+    wc.style = CS_HREDRAW | CS_VREDRAW | CS_DBLCLKS;
+    wc.lpfnWndProc = rm_wndproc;
+    wc.hInstance = inst;
+    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+    wc.hbrBackground = NULL;
+    wc.hIcon = rm_icon_big;
+    wc.hIconSm = rm_icon_small;
+    wc.lpszClassName = "RubenchikMirrorHost";
+    RegisterClassExA(&wc);
+
+    WNDCLASSEXA vc;
+    memset(&vc, 0, sizeof(vc));
+    vc.cbSize = sizeof(vc);
+    vc.style = CS_DBLCLKS;
+    vc.lpfnWndProc = rm_video_wndproc;
+    vc.hInstance = inst;
+    vc.hCursor = LoadCursor(NULL, IDC_ARROW);
+    vc.lpszClassName = "RubenchikMirrorVideo";
+    RegisterClassExA(&vc);
+
+    int sw = GetSystemMetrics(SM_CXSCREEN), sh = GetSystemMetrics(SM_CYSCREEN);
+    int w = 1280, h = 760;
+    if (w > sw - 80) w = sw - 80;
+    if (h > sh - 80) h = sh - 80;
+    rm_host = CreateWindowExA(WS_EX_APPWINDOW, "RubenchikMirrorHost", "Rubenchik Mirror",
+                              WS_POPUP | WS_THICKFRAME | WS_MINIMIZEBOX | WS_CLIPCHILDREN | WS_CLIPSIBLINGS,
+                              (sw - w) / 2, (sh - h) / 2, w, h, NULL, NULL, inst, NULL);
+    rm_video = CreateWindowExA(0, "RubenchikMirrorVideo", "", WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS,
+                               0, RM_TITLE_H, w, h - RM_TITLE_H, rm_host, NULL, inst, NULL);
+    /* Windows 11: remove the thin DWM border around the window (DWMWA_BORDER_COLOR = 34, DWMWA_COLOR_NONE) */
