+/* Returns the receiver's name (UTF-8) for the iPhone's list. The first time, the window asks for it and this call waits;
+   afterwards the saved name is used. Returns false when the host window is not in use. */
+bool video_renderer_ui_device_name(char *out_utf8, size_t outlen) {
+#ifdef _WIN32
+    if (!rm_host) return false;
+    wchar_t name[64] = L"";
+    if (!rm_name_load(name, 64)) {
+        wchar_t pc[64] = L"PC";
+        DWORD pcl = 64;
+        GetComputerNameW(pc, &pcl);
+        wchar_t suggestion[64];
+        _snwprintf(suggestion, 64, L"Rubenchik Mirror (%ls)", pc);
+        suggestion[63] = 0;
+        if (!rm_ui_ask_name(suggestion, name, 64)) return false;
+        rm_name_save(name);
+    }
+    rm_ui_set_device_name(name);
+    rm_ui_set_rename_cb(rm_rename_apply);
+    return WideCharToMultiByte(CP_UTF8, 0, name, -1, out_utf8, (int) outlen, NULL, NULL) > 0;
+#else
+    (void) out_utf8; (void) outlen;
+    return false;
+#endif
+}
