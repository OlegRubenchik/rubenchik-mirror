+#ifdef _WIN32
+/* The receiver's name is stored per Windows user in %APPDATA%\Rubenchik Mirror\device-name.txt (UTF-8). */
+static bool rm_name_file(wchar_t *path, size_t n, bool create_dir) {
+    wchar_t appdata[MAX_PATH];
+    DWORD len = GetEnvironmentVariableW(L"APPDATA", appdata, MAX_PATH);
+    if (len == 0 || len >= MAX_PATH) return false;
+    _snwprintf(path, n, L"%ls\\Rubenchik Mirror", appdata);
+    if (create_dir) CreateDirectoryW(path, NULL);
+    _snwprintf(path, n, L"%ls\\Rubenchik Mirror\\device-name.txt", appdata);
+    return true;
+}
+
+static bool rm_name_load(wchar_t *out, int n) {
+    wchar_t path[MAX_PATH + 64];
+    if (!rm_name_file(path, MAX_PATH + 64, false)) return false;
+    FILE *f = _wfopen(path, L"rb");
+    if (!f) return false;
+    char buf[256];
+    size_t r = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    buf[r] = '\0';
+    char *s = buf;
+    if ((unsigned char) s[0] == 0xEF && (unsigned char) s[1] == 0xBB && (unsigned char) s[2] == 0xBF) s += 3;   /* BOM */
+    size_t l = strlen(s);
+    while (l > 0 && (s[l - 1] == '\r' || s[l - 1] == '\n' || s[l - 1] == ' ' || s[l - 1] == '\t')) s[--l] = '\0';
+    if (!*s) return false;
+    return MultiByteToWideChar(CP_UTF8, 0, s, -1, out, n) > 0;
+}
+
+static void rm_name_save(const wchar_t *name) {
+    wchar_t path[MAX_PATH + 64];
+    if (!rm_name_file(path, MAX_PATH + 64, true)) return;
+    char utf8[256];
+    if (WideCharToMultiByte(CP_UTF8, 0, name, -1, utf8, sizeof(utf8), NULL, NULL) <= 0) return;
+    FILE *f = _wfopen(path, L"wb");
+    if (!f) return;
+    fputs(utf8, f);
+    fclose(f);
+}
+
+/* rename from the title bar: save the name, start a new copy of the app (it waits a few seconds so that the network
+   ports are free) and close this one */
+static void rm_rename_apply(const wchar_t *name) {
+    rm_name_save(name);
+    wchar_t exe[MAX_PATH];
+    if (GetModuleFileNameW(NULL, exe, MAX_PATH) > 0) {
+        wchar_t line[4096];
+        _snwprintf(line, 4096, L"%ls", GetCommandLineW());
+        SetEnvironmentVariableW(L"RUBENCHIK_DELAY_MS", L"3500");
+        STARTUPINFOW si;
+        PROCESS_INFORMATION pi;
+        memset(&si, 0, sizeof(si));
+        si.cb = sizeof(si);
+        memset(&pi, 0, sizeof(pi));
+        if (CreateProcessW(exe, line, NULL, NULL, FALSE, DETACHED_PROCESS, NULL, NULL, &si, &pi)) {
+            CloseHandle(pi.hThread);
+            CloseHandle(pi.hProcess);
+        }
+        SetEnvironmentVariableW(L"RUBENCHIK_DELAY_MS", NULL);
+    }
+    if (rm_close_cb) rm_close_cb(); else ExitProcess(0);
+}
+#endif
