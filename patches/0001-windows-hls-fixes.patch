+void video_renderer_select_media(int sub_on, const char *sub_lang, const char *audio_lang, const char *audio_name) {
+    (void) audio_name;
+    pending_sub_on = sub_on;
+    snprintf(pending_sub_lang, sizeof(pending_sub_lang), "%s", sub_lang ? sub_lang : "");
