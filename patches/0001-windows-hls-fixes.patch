     assert(master_playlist);
+#ifdef _WIN32
+    /* Rubenchik Mirror: when the mpv backend plays the video, leave all audio tracks in the playlist: YouTube marks
+       the original track DEFAULT=YES and mpv selects it (and lets the user switch tracks). */
+    if (mpv_hls_available()) {
+        prune_master_for_mpv(master_playlist);
+        return master_playlist;
+    }
+#endif
     /* filter out unwanted language renderings (AUDIO, SUBTITLES)  from  master playlist
 
     keep just one language per AUDIO rendition group, set DEFAULT=YES, AUTOSELECT= YES.
@@ -868,6 +1005,7 @@ char * select_master_playlist_language(airplay_video_t *airplay_video, char *mas
         free (master_playlist);
     }
     free(slice);
+    keep_only_h264_variants(new_master_playlist);
     return new_master_playlist;
 }
 
