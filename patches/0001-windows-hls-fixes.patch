+/* Create the window on its own thread. paths: logo bitmap (24-bit BMP) and icon file (.ico). */
+static bool rm_ui_start(const char *logo_bmp, const char *icon_ico, rm_state_fn state_cb, rm_close_fn close_cb, bool start_fullscreen) {
+    snprintf(rm_logo_path, sizeof(rm_logo_path), "%s", logo_bmp ? logo_bmp : "");
+    snprintf(rm_icon_path, sizeof(rm_icon_path), "%s", icon_ico ? icon_ico : "");
+    rm_state_cb = state_cb;
+    rm_close_cb = close_cb;
+    rm_auto_fullscreen = start_fullscreen;
+    rm_ready_event = CreateEventA(NULL, TRUE, FALSE, NULL);
+    HANDLE th = CreateThread(NULL, 0, rm_thread, NULL, 0, NULL);
+    if (!th) return false;
+    CloseHandle(th);
+    bool ok = (WaitForSingleObject(rm_ready_event, 5000) == WAIT_OBJECT_0) && rm_video != NULL;
+    /* Close the console window when started from a shortcut: detach from the console if uxplay is the only process
+       attached to it and stdout is the console itself (not redirected to a file/pipe, not started from a shell).
+       FreeConsole() also closes the Windows Terminal tab that Windows 11 opens for console programs.
+       Set RUBENCHIK_CONSOLE=1 to keep the console (for debugging). */
+    if (ok && !getenv("RUBENCHIK_CONSOLE")) {
+        HANDLE out = GetStdHandle(STD_OUTPUT_HANDLE);
+        DWORD mode = 0, pids[4];
+        bool out_is_console = (out != NULL && out != INVALID_HANDLE_VALUE && GetConsoleMode(out, &mode));
+        if (out_is_console && GetConsoleProcessList(pids, 4) == 1) {
