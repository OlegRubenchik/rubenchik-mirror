+/* Rubenchik Mirror: YouTube master playlists mix H.264 (avc1) and VP9 (vp09) variants. GStreamer's hlsdemux2 cannot
+   switch between the two codecs mid-stream (playback freezes), so if H.264 variants exist, drop all other-codec
+   variants (each #EXT-X-STREAM-INF line plus the URI line that follows it). Edits the string in place. */
+static void keep_only_h264_variants(char *playlist) {
+    if (!playlist || !strstr(playlist, "CODECS=\"avc1")) {
+        return;
+    }
+    char *src = playlist;
+    char *dst = playlist;
+    while (*src) {
+        char *eol = strchr(src, '\n');
+        size_t len = eol ? (size_t) (eol - src) + 1 : strlen(src);
+        if (!strncmp(src, "#EXT-X-STREAM-INF", 17)) {
+            char *line_end = src + len;
+            bool is_h264 = false;
+            for (char *q = src; q + 12 < line_end; q++) {
+                if (!strncmp(q, "CODECS=\"avc1", 12)) { is_h264 = true; break; }
+            }
+            char *next = line_end;
+            char *next_eol = *next ? strchr(next, '\n') : NULL;
+            size_t next_len = *next ? (next_eol ? (size_t) (next_eol - next) + 1 : strlen(next)) : 0;
+            if (!is_h264) {
+                src = next + next_len;   /* skip tag line and its URI line */
+                continue;
+            }
+            memmove(dst, src, len + next_len);
+            dst += len + next_len;
+            src = next + next_len;
+            continue;
+        }
+        memmove(dst, src, len);
+        dst += len;
+        src += len;
+    }
+    *dst = '\0';
+}
+
+/* Rubenchik Mirror (mpv backend): ffmpeg's HLS demuxer, used by mpv, probes EVERY variant and audio rendition before
+   playback starts and does not switch qualities during playback. So keep only the best (highest BANDWIDTH) video variant
+   and the audio/subtitle renditions of its group. Edits the string in place (the result is never longer). */
+static bool hls_attr(const char *line, size_t len, const char *key, char *out, size_t outlen) {
+    size_t klen = strlen(key);
+    for (size_t i = 0; i + klen <= len; i++) {
+        if ((i == 0 || line[i - 1] == ',' || line[i - 1] == ':') && !strncmp(line + i, key, klen)) {
+            const char *v = line + i + klen;
+            bool quoted = (*v == '"');
+            if (quoted) v++;
+            size_t n = 0;
+            while (v + n < line + len && v[n] != '\n' && v[n] != '\r' && (quoted ? v[n] != '"' : v[n] != ',') && n + 1 < outlen) {
+                out[n] = v[n];
+                n++;
+            }
+            out[n] = '\0';
+            return true;
+        }
+    }
+    return false;
+}
+
+static void prune_master_for_mpv(char *playlist) {
+    if (!playlist || !strstr(playlist, "#EXT-X-STREAM-INF")) {
+        return;
+    }
+    const char *best_line = NULL;
+    long best_bw = -1;
+    char best_audio[64] = "", best_subs[64] = "";
+    for (const char *l = playlist; *l; ) {
+        const char *e = strchr(l, '\n');
+        size_t len = e ? (size_t) (e - l) + 1 : strlen(l);
+        if (!strncmp(l, "#EXT-X-STREAM-INF", 17)) {
+            char bw[32];
+            if (hls_attr(l, len, "BANDWIDTH=", bw, sizeof(bw))) {
+                long b = atol(bw);
+                if (b > best_bw) {
+                    best_bw = b;
+                    best_line = l;
+                    best_audio[0] = best_subs[0] = '\0';
+                    hls_attr(l, len, "AUDIO=", best_audio, sizeof(best_audio));
+                    hls_attr(l, len, "SUBTITLES=", best_subs, sizeof(best_subs));
+                }
+            }
+        }
+        l += len;
+    }
+    if (!best_line) {
+        return;
+    }
+    char *out = (char *) calloc(strlen(playlist) + 1, 1);
+    if (!out) {
+        return;
+    }
+    char *dst = out;
+    bool keep_next_uri = false, skip_next_uri = false;
+    for (const char *l = playlist; *l; ) {
+        const char *e = strchr(l, '\n');
+        size_t len = e ? (size_t) (e - l) + 1 : strlen(l);
+        bool keep = true;
+        if (keep_next_uri || skip_next_uri) {
+            keep = keep_next_uri;
+            keep_next_uri = skip_next_uri = false;
+        } else if (!strncmp(l, "#EXT-X-STREAM-INF", 17)) {
+            keep = (l == best_line);
+            if (keep) keep_next_uri = true; else skip_next_uri = true;
+        } else if (!strncmp(l, "#EXT-X-I-FRAME-STREAM-INF", 25)) {
+            keep = false;
+        } else if (!strncmp(l, "#EXT-X-MEDIA:", 13)) {
+            char type[32] = "", group[64] = "";
+            hls_attr(l, len, "TYPE=", type, sizeof(type));
+            hls_attr(l, len, "GROUP-ID=", group, sizeof(group));
+            if (!strcmp(type, "AUDIO")) {
+                keep = !best_audio[0] || !strcmp(group, best_audio);
+            } else if (!strcmp(type, "SUBTITLES")) {
+                keep = best_subs[0] && !strcmp(group, best_subs);
+            }
+        }
+        if (keep) {
+            memcpy(dst, l, len);
+            dst += len;
+        }
+        l += len;
+    }
+    *dst = '\0';
+    strcpy(playlist, out);
+    free(out);
+}
